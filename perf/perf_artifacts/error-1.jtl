  <responseData class="java.lang.String">&lt;!DOCTYPE html&gt;
&lt;html lang=&quot;de&quot;&gt;
&lt;head&gt;
&lt;meta charset=&quot;utf-8&quot;&gt;
&lt;meta http-equiv=&quot;X-UA-Compatible&quot; content=&quot;IE=edge&quot;&gt;
&lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1&quot;&gt;
&lt;meta name=&quot;google-site-verification&quot; content=&quot;fboe3v4xQpyXzOHkjBod2Z3fDLlBhBX-RBOnK-nZvmI&quot; /&gt;

&lt;title&gt;Komplettlösung zur Videoüberwachung für Zuhause | Smartfrog&lt;/title&gt;
&lt;meta name=&quot;description&quot; content=&quot;Schau von überall, was gerade Zuhause passiert | die einfache Komplettlösung zur Videoüberwachung | dein Zuhause jederzeit und von überall erreichbar&quot; /&gt;
&lt;link rel=&quot;icon&quot; href=&quot;/static/favicon.ico&quot;&gt;
&lt;link rel=&quot;stylesheet dns-prefetch&quot; type=&quot;text/css&quot; href=&quot;https://fonts.googleapis.com/css?family=Roboto+Condensed:700,400,300&quot; media=&quot;all&quot;&gt;

&lt;link rel=&quot;stylesheet&quot; href=&quot;/static/bootstrap_white01/bootstrap/css/bootstrap.min.css&quot; /&gt;
&lt;link rel=&quot;stylesheet&quot; href=&quot;/static/bootstrap_white01/css/reset.min.css&quot; /&gt;
&lt;link rel=&quot;stylesheet&quot; href=&quot;/static/bootstrap_white01/css/sf-styling.min.css&quot; /&gt;
&lt;link rel=&quot;stylesheet&quot; href=&quot;/static/bootstrap_white01/css/main.min.css&quot; /&gt;
&lt;link rel=&quot;stylesheet&quot; href=&quot;/static/bootstrap_white01/css/homepage.min.css&quot; /&gt;
&lt;link rel=&quot;stylesheet&quot; href=&quot;/static/bootstrap_white01/css/first-utility.min.css&quot; /&gt;
&lt;link rel=&quot;stylesheet&quot; href=&quot;/static/bootstrap_white01/css/distributors.min.css&quot; /&gt;
&lt;link rel=&quot;stylesheet&quot; href=&quot;/static/bootstrap_white01/css/press.min.css&quot; /&gt;
&lt;link rel=&quot;sitemap&quot; type=&quot;text/sitemap&quot; title=&quot;Sitemap&quot; href=&quot;https://smartfrog.com/sitemapIndex.xml&quot; /&gt;
&lt;script&gt;
        var doc = document.documentElement;
        doc.setAttribute(&apos;data-useragent&apos;, navigator.userAgent);
    &lt;/script&gt;
&lt;script&gt;
        var current_url_localized_path = {
        
        &quot;de&quot;: &quot;&quot;,
        
        &quot;en&quot;: &quot;&quot;,
        
        &quot;default&quot;: &quot;&quot;
        };
